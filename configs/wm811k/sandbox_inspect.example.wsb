<Configuration>
  <!-- 공유용 템플릿입니다. 직접 실행하지 말고 .local.wsb 복사본의 __PROJECT_ROOT__ 네 곳을 수정하세요. -->
  <Networking>Disable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <vGPU>Disable</vGPU>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <MemoryInMB>16384</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>__PROJECT_ROOT__\data\raw\wm811k</HostFolder>
      <SandboxFolder>C:\wm_input</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>__PROJECT_ROOT__\.sandbox_offline</HostFolder>
      <SandboxFolder>C:\wm_offline</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>__PROJECT_ROOT__\scripts\wm_sandbox</HostFolder>
      <SandboxFolder>C:\wm_tools</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
    <MappedFolder>
      <HostFolder>__PROJECT_ROOT__\.sandbox_output</HostFolder>
      <SandboxFolder>C:\wm_output</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
</Configuration>
