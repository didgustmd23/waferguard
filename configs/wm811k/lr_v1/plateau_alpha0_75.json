{
  "training_version": "wm_cnn_train_v1",
  "batch_size": 64,
  "epochs": 30,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "patience": 6,
  "seed": 42,
  "class_weighted": true,
  "max_class_weight": 10.0,
  "class_weight_alpha": 0.75,
  "scratch_weight_factor": 1.0,
  "selection_metric": "macro_f1",
  "lr_scheduler": {
    "type": "ReduceLROnPlateau",
    "metric": "macro_f1",
    "mode": "max",
    "factor": 0.5,
    "patience": 2,
    "threshold": 0.0,
    "threshold_mode": "abs",
    "cooldown": 0,
    "min_lr": 0.00001,
    "eps": 1e-8
  }
}
