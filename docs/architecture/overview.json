  "cards": [
    {
      "title": "서로 독립된 실행",
      "items": [
        "세 영역 사이에 자동 데이터·결과 전달은 없다.",
        "공통 코드 참조를 실행 연결선으로 그리지 않았다."
      ],
      "dot": "cyan"
    },
    {
      "title": "LLM과 계산의 구분",
      "items": [
        "LLM은 원본 행·이미지·승인 정보의 자동 수신자가 아니다.",
        "직접 실행·승인 권한이 없고 응답은 검증 대상이다."
      ],
      "dot": "violet"
    },
    {
      "title": "보존한 지원 경계",
      "items": [
        "고급 WM 모듈은 기존 웨이퍼 계산을 재사용한다.",
        "통합 작업의 웨이퍼 프로파일 연결 완료를 뜻하지 않는다.",
        "WM 학습 점선은 구현된 학습 경로가 아니다."
      ],
      "dot": "amber"
    },
    {
      "title": "학습 구현과 계획의 구분",
      "dot": "amber",
      "items": [
        "SECOM은 기존 학습·평가 경로를 표시하며 새 학습을 실행하지 않았다.",
        "WM의 CNN·ResNet18 학습과 평가·모델 선택은 계획 단계다.",
        "통합 전처리 에이전트에서 두 학습 경로로 자동 전달하지 않는다."
      ]
    }
  ]
