# Python
__pycache__/
*.py[cod]
*.pyo

# 로컬 비밀정보와 인증 파일 (빈 설정 예제만 공유)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
.secrets/
/.streamlit/secrets.toml

# 승인·상태 DB와 SQLite 부속 파일은 위치와 무관하게 로컬 보관
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Virtual Environment
.venv/
venv/
ml310/

# VS Code
.vscode/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# 데이터 전체는 로컬에서 관리하며 폴더 유지용 .gitkeep만 허용
# 원본·canonical·분할 색인·입력 캐시·데모 입력을 모두 포함
/data/**
!/data/**/
!/data/**/.gitkeep

# data 밖에 저장된 원본·숫자 배열도 실수로 추가하지 않음
*.pkl
*.pickle
*.npz
*.npy
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.mat

# Temporary files
.sandbox_offline/
.sandbox_output/
/tmp*/
*.tmp
*.log
*.etl
*.dmp

# 개인 호스트 경로가 들어가는 Sandbox 실행 설정
/configs/wm811k/sandbox_inspect.local.wsb

# Data
*.data
*.csv
!/reports/secom/results/v2_sensor_comparison.csv
!/reports/secom/results/v2_fixed_scenarios.csv
!/reports/secom/results/v2_bundle_verification.csv
!/reports/secom/results/v2_existing_test_comparison.csv
*.xls

# 재생성 가능한 split 생성 계약 (원본·설정으로 다시 생성)
/data/splits/**/manifest.json

# 재생성 가능한 평가 실행 상태와 설정 기록
/logs
/logs/**/execution.json
/logs/**/temporal_run.json
/logs/**/anomaly_run.json
/logs/**/feature_run.json

# 로컬 후보 모델 묶음 (학습 모델·검증용 센서 입력 포함)
/models/candidates/
/models/retired/

# WM-811K 학습 checkpoint와 로컬 실행 보고서
/models/wm811k/
/reports/wm811k/canonical_validation_*/
/reports/wm811k/split_diagnosis_*/
/reports/wm811k/test_evaluation_*/
/reports/wm811k/transform_v2/

# 다운로드·학습·직렬화한 모델은 소스와 별도 관리
*.gguf
*.safetensors
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
pytorch_model*.bin
/graphify-out/

# Archify 초안·화면 캡처·로컬 검증 기록
/.archify/
# 공유할 최종 HTML·SVG·편집용 JSON은 docs/architecture에 유지한다.
# delivery 영수증은 로컬 절대 경로를 포함하므로 이 PC에서만 보관한다.
/docs/architecture/*.delivery.json
